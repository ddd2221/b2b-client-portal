# ============================================================
# AgencyFlow Environment Variables Configuration
# ============================================================

# Django Backend Settings
DJANGO_SECRET_KEY=django-insecure-agencyflow-portfolio-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database Settings
POSTGRES_DB=agencyflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# Host-side port for connecting GUI tools (DBeaver/pgAdmin) to Postgres.
# Not 5432: on Windows it is often in a Hyper-V reserved port range.
DB_HOST_PORT=15432

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api
INTERNAL_BACKEND_URL=http://backend:8000
